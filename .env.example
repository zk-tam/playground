# Copy this file to .env.local and fill it in. .env.local is never committed.

# The Postgres connection string of the Supabase project.
# Supabase dashboard → Connect → Connection string. Use the "Transaction
# pooler" one (port 6543) when hosting on serverless, the "Session pooler" one
# (port 5432) otherwise. Replace [YOUR-PASSWORD] with the database password;
# if it has special characters, percent-encode them.
# Then create the tables once:  npm run db:setup
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:6543/postgres

# The site's public address, used to build link previews. Set it when deployed.
# It is fixed when the site is built, so one build has one address. With two
# domains on the same deployment, put the main one here: both domains work,
# and previews shared from either point at the main one. With a separate
# deployment per domain, give each its own.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
